# ============================================================================
# Timescale Crypto OHLCV Collector — environment template
#
# Format: KEY=value — no quotes, no spaces around '='.
# Unknown keys are SILENTLY IGNORED (pydantic extra="ignore"), so a typo in a
# name means the setting is simply not applied. Verify before starting:
#   poetry run python -c "from config.settings import settings; \
#     print(settings.model_dump())"
# ============================================================================

# ---------------------------------------------------------------- Database ---
# NOTE: `main.py init-db` connects to the maintenance database "postgres" and
# runs CREATE DATABASE + CREATE EXTENSION timescaledb. So this role needs
# CREATEDB, and the role enabling the extension needs SUPERUSER — otherwise
# TimescaleDB stays off and drop_chunks() cannot work (retention falls back to
# a slow row-by-row DELETE).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=***
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10

# ------------------------------------------- The 4 historical database names -
DB_HIGH_1D=ohlcv_1d_data_for_usdt_pairs_using_ccxt_and_direct_api1
DB_LOW_1D=ohlcv_1d_data_for_low_vol_usdt_pairs_using_ccxt_and_direct_api1
DB_HIGH_15M=ohlcv_15m_data_for_usdt_pairs_using_ccxt_and_direct_api1
DB_LOW_15M=ohlcv_15m_low_vol_usdt_pairs_using_ccxt_and_direct_api1

# ------------------------------------------------------------------ Proxy ----
# SOCKS5 used by ccxt. Empty = no proxy (this is what docker-compose sets).
# If a URL is configured but the proxy is not running, every request fails on
# connect.
SOCKS5_PROXY=socks5://127.0.0.1:10808

# ------------------------------------------------------- Timeframes & volume -
# Retention window of the 15m tables; drives drop_chunks()/DELETE.
DATA_RETENTION_DAYS=180
UPDATE_DAYS=10

# HIGH <-> LOW tiering threshold, USD per day averaged over the last N days.
# Separate per timeframe. There is NO plain "HARD_FLOOR_USD" key.
HARD_FLOOR_USD_1D=500000
HARD_FLOOR_USD_15M=125000
MIN_DAYS_VOLUME_CHECK=7

# Cycle period of each engine. There is NO plain "UPDATE_INTERVAL_SECONDS" key.
UPDATE_INTERVAL_SECONDS_1D=3600
UPDATE_INTERVAL_SECONDS_15M=300

CONCURRENT_PER_EXCHANGE=5

# --------------------------------------------------------------- Backfill ----
BACKFILL_NEW_TABLES=true
BACKFILL_OLDER_EXISTING_TABLES=true
BACKFILL_START_DATE=2018-01-01
BACKFILL_MAX_ITERATIONS=400
BACKFILL_REQUEST_LIMIT=1000
# Repair of truncated table starts: pages of OLDER candles per pair per cycle.
HISTORY_PREFILL_MAX_PAGES=10
HISTORY_PREFILL_RETRY_SEC=14400

# ------------------------------------------------------------ Gap filling ----
CHECK_AND_FILL_GAPS=true
GAP_MAX_PAGES_PER_RANGE=50
GAP_FILLER_BUDGET_SEC=600
GAP_RECHECK_SEC=21600
GAP_TOLERANCE_SEC_15M=1800
EMPTY_SYMBOL_RETRY_SEC=86400

# ------------------------------------------------- Orderbook / CVD / tape ----
COLLECT_ORDERBOOK=true
DEBUG_ORDERBOOK=false
OB_FETCH_LIMIT=50
OB_TRADES_LIMIT=100
OB_TRADES_WINDOW_SEC=300
OB_DEPTH_PCT=1.0

# ------------------------------- Open interest & funding (perpetuals only) ---
COLLECT_OI_FUNDING=true
FUNDING_HISTORY_BACKFILL=true
FUNDING_HISTORY_MAX_PAGES=100

# ------------------------------------- ATR without paranormal bars ----------
# This is the window the ENGINES store: daily tables get 1D_ATR(ATR_PERIOD) in
# ob_atr_no_paranormal / ob_spread_atr_pct, 15m tables get 15m_ATR(ATR_PERIOD)
# (Gerchik-smoothed) in ob_gerchik_atr. The dashboard labels those columns with
# these names; its own live strip and metric cards use a separate per-session N
# (Chart options -> ATR Period), whose label follows the slider automatically.
ATR_PERIOD=5
ATR_SMALL_THRESHOLD=0.5
ATR_LARGE_THRESHOLD=1.8

# ------------------------------------------------------ Logging / progress ---
PROGRESS_LOG_EVERY=25
PRECOUNT_PAIRS=true

# ------------- Low-resource machines (16 GB RAM, local Postgres, desktop) ----
# Fewer parallel exchange jobs -> smaller CPU spikes, slightly longer cycles.
#CONCURRENT_PER_EXCHANGE=3
# Background DB connections per database (applies to BOTH 1d and 15m pools).
#DB_MAX_POOL_SIZE=4
#DB_MIN_POOL_SIZE=2
# How many pairs on each side are prefetched (charts/candles; default 2 — more
# neighbours cost more database and exchange traffic than they save clicks; 0..2
# remove UI stutter on weak machines, 5 is the old full warm). A pair is warmed at
# most once per chart-page lifetime (45 s), the warm starts DASH_WARM_DELAY_SEC
# after the click so the click itself is served first, and pairs whose collector
# stopped writing (leftover dead spot tables) get NO background exchange calls.
#DASH_WARM_NEIGHBORS=2
#DASH_WARM_DELAY_SEC=1.5
# Renders slower than this print "[switch] …" lines saying whether the time went
# to the database, to Streamlit, or to building the page. Paste one of those lines
# when switching feels slow — it is the difference between three opposite fixes.
#DASH_SWITCH_REPORT_MS=250
#DASH_WARM_STALE_SKIP_SEC=172800
# 15m retention (drop_chunks/DELETE) + VACUUM runs at most once per N hours.
#MAINTENANCE_INTERVAL_HOURS=24

# ---------------------------------------------------- Dashboard startup scan ---
# The pair list is one UNION ALL per CHUNK of tables (NOT one query per pair).
# If a startup still feels slow, these are the three knobs that matter:
#   BUDGET — render whatever answered in time instead of spinning; a scan cut
#            short is shown as "pair list incomplete" and is NEVER cached as
#            the startup snapshot (that is how a busy collector would otherwise
#            shrink the list from launch to launch).
#   CHUNK  — tables per query. Bigger = fewer round trips.
#   POOL   — parallel chunk queries against one database.
#DASH_SCAN_BUDGET_SEC=25
# The budget of a LATER pass of a sweep that is still building the pair list,
# while nobody has touched the page for 2s. The first paint always uses
# DASH_SCAN_BUDGET_SEC, so opening the dashboard costs what it always cost.
# 120s is sized by measurement: 8 245 tables at ~0.05s a table on 6 pooled
# connections is ONE pass, where 25s slices made it 15-20 passes of "pair list
# incomplete" (their 15m tier). It is not more load - no chunk is asked twice and
# the catalog is reused mid-sweep - it is the same load in fewer passes. Lower it
# (or 0) while the collector is running if charts start feeling the sweep.
#DASH_SCAN_BUDGET_IDLE_SEC=120
#DASH_SCAN_CHUNK_SIZE=120
#DASH_SCAN_POOL_SIZE=6
# Databases scanned at once inside one summary scan; the whole scan also holds
# a process-wide gate, so 1 here means "at most one heavy sweep at a time".
# Raise it only on an idle database — on a loaded one it multiplies the load.
#DASH_SCAN_MAX_PARALLEL_DBS=1
# How long the sweep pauses after a Prev/Next click so the chart query wins
# (0 disables). The pause is capped at ~20% of DASH_SCAN_BUDGET_SEC per sweep.
#DASH_SCAN_YIELD_GAP_SEC=1.2
# Cap on the table-by-table recovery of a chunk that failed on a TYPE problem
# (0 disables it). A chunk that only TIMED OUT is never recovered: retrying 120
# queries against a busy server is how the dashboard used to eat the database.
#DASH_SCAN_RECOVERY_MAX_TABLES=24
# How often the table/column inventory (pg_catalog) is re-read per database.
# On a 14k-table database this read is far more expensive than the data scan
# itself (measured 14-17s on the 8k-table 15m/LOW database), so it is cached;
# the scan used to do it on every rerun. An EXPIRED listing is additionally
# reused until the current sweep wraps - re-reading it mid-sweep steals budget
# from the very tables that have no answer yet. Raise it if you want newly
# listed pairs to appear faster, set 0 to re-read every scan.
#DASH_SCAN_INVENTORY_TTL_SEC=600
# A real read is also kept on disk (next to the summary snapshot) and a cold
# process starts from it instead of paying 14-27s of pg_catalog BEFORE its first
# chunk — which is how their restarts kept opening at "0/70 chunks answered".
# Accepted as fresh for one TTL; a table that no longer exists is still dropped by
# the chunk that names it, and a newly listed pair waits at most one TTL plus the
# sweep. Delete `inventory_*.pkl` in the cache dir to force a re-read.
# How long ONE catalog listing read may take before the sweep stops waiting for
# it: with a previous listing in hand that one is reused for the pass, without
# one the pass reports a FAILED read (never "no pairs"). Their first sweep after a
# restart spent 27.3s of 56s on pg_catalog and answered 0 of 69 chunks - an
# unbounded catalog read is a scan budget leak.
#DASH_SCAN_CATALOG_TIMEOUT_SEC=45
# Minimum gap between two BACKGROUND rescans while a valid snapshot exists on
# disk. Every rerun of the app (pair click, 60s auto-reload) used to launch a
# full 4-database scan: the scans slowed the database, the slower scans hit
# their budget and returned a shorter pair list — a self-sustaining loop.
# The gate now applies to TRUNCATED scans as well, doubling per consecutive
# truncated scan (see DASH_SCAN_RETRY_MAX_SEC) and resetting on a complete one.
#DASH_SNAPSHOT_REFRESH_SEC=120
#DASH_SCAN_RETRY_MAX_SEC=1800
# A 25s budget answers ~12 of an 8271-table database's 69 chunks, and the cut
# always falls on the same tail: every retry re-read those 1318 tables and the
# other 6953 never appeared in the list. So a sweep now resumes where the last
# one stopped, and the rows it already answered stay usable for this long while
# the rest of the database is being read. Set 0 to go back to showing only the
# slice the current sweep managed (the list then shrinks between frames).
#DASH_SCAN_CARRYOVER_TTL_SEC=900
# A tier whose scan could not start because the OTHER tier holds the scan gate
# retried only after the full backoff, which on a busy collector meant "1d:
# skipped — another scan holds the database" for hours. Skipping queries nothing,
# so it is retried after this delay instead, at most 3 times in a row.
#DASH_SCAN_DEFER_RETRY_SEC=8
# How long a COMPLETE pair-list scan is kept before the tier is re-scanned.
# Both tiers share one scan gate; without this floor the tier that keeps
# finishing can re-scan every refresh and starve the other one into an
# incomplete (or empty) list. 0 = rescan whenever the refresh tick fires.
DASH_SCAN_RESCAN_COMPLETE_SEC=300
# Last good pair list is kept on disk (~/.cache/timescale-ohlcv-dashboard) and
# painted instantly while a fresh scan runs in the background.
#DASH_SNAPSHOT_ENABLED=true
#DASH_SNAPSHOT_DIR=
#DASH_SNAPSHOT_MAX_AGE_SEC=86400

# --------------------------- Pair switching (Charts tab, Prev / Next) -------
# The switch renders the candles that are ALREADY in TimescaleDB; everything
# that needs the exchange runs in background threads and is swapped in after:
#   • the gap/tail stitch (fills missing candles into the chart, in-memory)
#   • the live chips (ticker / orderbook top / trade tape) when the live daemon
#     has not written a row for the new pair yet
# So a pair with holes paints immediately instead of waiting for this budget.
#DASH_STITCH_BUDGET_SEC=4.0
# A catch-up range that FAILED (or only partly arrived) is asked again after this
# many seconds. A successful answer is kept for an hour — closed bars never
# change — but a refusal is not an answer: caching it for an hour is what left a
# chart with the same hole long after the exchange was reachable again, and made
# the caption blame the exchange for a dashboard-side timeout.
#DASH_STITCH_RETRY_SEC=20
# A stitch (or a live chip) that finds the exchange's markets unloaded never calls
# load_markets() on the render path: it starts one background load per exchange
# and pauses after a failure with an exponential backoff, instead of every pair
# re-loading the market catalog every second until the endpoint starts timing
# out. `[markets]` in the console names the exchange and the error.
# One ccxt load_markets() per exchange, in the background, with a backoff after
# a failure. 60s: gate's own market list can take 30-40s, and a timed-out load is
# not a slower chart - it means every gap stitch and live feed on that exchange
# answers "markets are loading" until it works.
#DASH_MARKET_LOAD_TIMEOUT_SEC=60

# ------------------------------------- ccxt market loading -------------------
# Skip the exchange CURRENCY table that ccxt loads before the market catalog
# (gate: /spot/currencies — slow, rate limited, unused here). Turning it off is
# what keeps `load_markets for gateio failed (attempt 1/3): TimeoutError()` from
# silently skipping a whole exchange for the cycle. Set true only while debugging
# precision/limit issues.
#CCXT_FETCH_CURRENCIES=false
# Market categories to SKIP inside load_markets(). ccxt issues one request per
# category an exchange declares (gate: spot, swap, future, option) and a sync
# instance runs them one after another under a single timeout — so one slow
# category means no markets at all, and that means no candles, no tape and no gap
# stitching on that exchange, perpetuals included (a gate *spot* timeout starved
# their BLUR/USDT:USDT perp). This project stores spot and linear perp candles, so
# the option contract list is never fetched. A deny-list on purpose: bybit calls
# its perps "linear", so an allow-list would delete them; exchanges that express
# the types as per-category flags (mexc) are left exactly as ccxt configured them.
# "" = never trim.
#CCXT_MARKET_TYPES_SKIP=option
# After a FAILED market load, time each market category separately and print
# `[markets] gate: probe with timeout 60s — spot ok, 1809 markets, 3.1s; swap
# FAILED after 60.0s: RequestTimeout…`. Use it when the console says a load times
# out but `curl` of the same URL is fast: "the list is big" and "this connection
# is throttled/blackholed (IPv6? proxy? rate limit)" look identical otherwise and
# need opposite fixes. One load per category, only on the failure path — leave off
# in normal use.
#DASH_MARKET_LOAD_DEBUG=true

# --------------------------- The dashboard wakes the collector (both TFs) ----
# Opening a pair registers it in a tiny `dashboard_watch` table; the 15m AND the
# 1D engine each refresh the watched pair on their own timeframe, in the database
# where its table actually lives, every PRIORITY_LANE_INTERVAL_SEC(=_1D). The
# refresh starts at the table's own last bar, so it also REWRITES the forming
# candle (a bar frozen mid-flight) instead of appending next to it.
# When the table is further behind, the same fetch is anchored at the hole itself
# and grows long enough to bridge it — one request per tick, so a collector that
# slept through a night or a filtered-out symbol comes back to the chart closed,
# not refreshed around the gap. A hole deeper than this many bars is history, not
# a tail: the full sweep (and backfill) owns it, and the lane stays light.
#   2000 x 15m = ~20 days, 2000 x 1D = 5 years. 0 = tail-only, the old behaviour.
#PRIORITY_LANE_CATCHUP_MAX_BARS=2000
# Note: `main.py run` collects 1D only by default. `python main.py run
# --timeframe all` (or a second process with --timeframe 15m) is what makes the
# 15m half of that handshake answer; each engine stamps served_15m_at /
# served_1d_at in this table, and each chart's caption names the timeframe whose
# engine is missing.

# ------------------------------------- Exchanges: include / exclude lists ----
# Include-list. Empty = all exchanges of the maps (1D: 9, 15M: bybit, gateio,
# mexc, okx, bingx). Both comma-separated and JSON list formats are accepted.
# Example: ALLOWED_EXCHANGES=bybit,gateio,mexc,okx,bingx
ALLOWED_EXCHANGES=

# Exclude-list (ccxt ids). Applied AFTER ALLOWED_EXCHANGES, so it wins on
# conflicts: handy for switching one exchange off without rewriting the whole
# include-list.
EXCLUDED_EXCHANGES=

# 15m engine: on startup, DROP tables of exchanges missing from the effective
# allow-list. DANGEROUS. Defaults to true in code, but with an EMPTY
# ALLOWED_EXCHANGES the cleanup turns itself off ("all allowed" -> nothing to
# drop). Keep this false until you have confirmed no tables of other exchanges
# (bitget, kucoin, htx, coinex) live in the 15m databases: they would go away
# via DROP TABLE ... CASCADE.
DELETE_NOT_ALLOWED_EXCHANGE_TABLES_ON_START=false
