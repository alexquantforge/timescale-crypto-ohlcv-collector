# Database Server Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Exact 4 Historical Database Names
DB_HIGH_1D=ohlcv_1d_data_for_usdt_pairs_using_ccxt_and_direct_api1
DB_LOW_1D=ohlcv_1d_data_for_low_vol_usdt_pairs_using_ccxt_and_direct_api1
DB_HIGH_15M=ohlcv_15m_data_for_usdt_pairs_using_ccxt_and_direct_api1
DB_LOW_15M=ohlcv_15m_low_vol_usdt_pairs_using_ccxt_and_direct_api1

# Proxy Settings
SOCKS5_PROXY=socks5://127.0.0.1:10808

# Execution Settings
TIMEFRAME=1d
DATA_RETENTION_DAYS=180
HARD_FLOOR_USD=500000
MIN_DAYS_VOLUME_CHECK=7
CONCURRENT_PER_EXCHANGE=15
UPDATE_DAYS=10
UPDATE_INTERVAL_SECONDS=3600

# Feature Flags
COLLECT_ORDERBOOK=true
CHECK_AND_FILL_GAPS=true
BACKFILL_NEW_TABLES=true
BACKFILL_OLDER_EXISTING_TABLES=true
BACKFILL_START_DATE=2018-01-01
